# Copy to .env and fill in. Never commit .env.

# --- Agent (phase 2) ---
AGENT_AUTH=subscription        # subscription | api_key
ANTHROPIC_API_KEY=             # only if AGENT_AUTH=api_key
CLAUDE_BIN=claude
# Must be OUTSIDE the repository (default: ~/.clabpilot/agent_workspace)
AGENT_WORKDIR=
AGENT_MODEL=
AGENT_MAX_TURNS=8
AGENT_TIMEOUT=120

# --- Discord (phase 2) ---
DISCORD_BOT_TOKEN=
DISCORD_OWNER_ID=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_BRIEFING=
DISCORD_CHANNEL_AGENT=
DISCORD_CHANNEL_CAPTURE=
DISCORD_CHANNEL_PROPOSALS=
# Webhooks allowed to talk to the agent in #agent (comma-separated ids, optional)
DISCORD_AGENT_WEBHOOK_IDS=
BRIEFING_TIME=07:30
BRIEFING_NUDGE_TIME=10:00
EXPORT_TIME=03:00

# --- Web / API ---
API_TOKEN=
DJANGO_SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
TIMEZONE=Europe/Paris

# --- Storage ---
# DATABASE_PATH defaults to ./data/clabpilot.sqlite3 (never in a cloud-synced folder)
DATABASE_PATH=
# One folder per cloud, separated by ";" (e.g. OneDrive and Google Drive)
EXPORT_DIRS=
EXPORT_KEEP_JSON=30
LOG_DIR=
LOG_LEVEL=INFO
